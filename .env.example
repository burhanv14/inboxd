# inboxd environment variables
# Copy to .env and fill in your keys. Never commit .env.

# --- Google Custom Search ---
CSE_API_KEY=
CSE_ID=

# --- MCP Server ---
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TRANSPORT=stdio

# --- Concurrency ---
SEARCH_CONCURRENCY=8

# --- Runtime defaults ---
DEFAULT_MAX_RESULTS=50
DEFAULT_MIN_SCORE=7
DEFAULT_PAGES=2

# --- Misc ---
LOG_LEVEL=INFO
