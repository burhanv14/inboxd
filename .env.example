# leadfinder environment variables
# Copy to .env and fill in your keys. Never commit .env.

# --- LLM (NVIDIA NIM) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_LARGE=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_SMALL=meta/llama-3.1-8b-instruct

# --- Google Custom Search ---
CSE_API_KEY=
CSE_ID=

# --- Concurrency ---
SEARCH_CONCURRENCY=8
LLM_CONCURRENCY=8

# --- Runtime defaults ---
DEFAULT_MAX_RESULTS=50
DEFAULT_MIN_SCORE=7
DEFAULT_MIN_RESULTS=10
DEFAULT_PAGES=2

# --- Misc ---
LOG_LEVEL=INFO
